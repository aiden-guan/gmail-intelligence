# Created by `npm run setup` if you don't have a .env yet.
# Do not commit this file once it contains a real token.

# Token for the tracking API. setup replaces the placeholder.
# The same value is written to workers/tracker/.dev.vars
PERSONAL_API_TOKEN=generate-a-long-random-token

# Optional. Leave the placeholders to try tracking on this computer
# with `npm run tracker` (in-memory, resets when you stop it).
# Fill these only when you deploy the Cloudflare Worker.
TRACKER_BASE_URL=https://your-tracker.example.workers.dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-extension

# AI keys are entered in the extension Settings page and stored in
# chrome.storage.local (service worker only). Never put them here.
