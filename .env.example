# PigeonBox — local development and self-hosting.
# `npm run setup` copies this to .env (gitignored) and fills the token.
# Nothing here is needed for the extension itself. AI keys are entered in
# Settings and stay in the extension's service worker; never put them here.
# PigeonBox Cloud (hosted SaaS) variables live in the private pigeonbox-cloud repo.

# --- Optional self-hosted tracker (workers/tracker) -------------------------
# Personal token for the tracker's management API. setup generates it and
# writes the same value to workers/tracker/.dev.vars.
PERSONAL_API_TOKEN=generate-a-long-random-token

# Leave these placeholders to run the tracker on this computer with
# `npm run tracker` (in-memory, resets when you stop it). Fill them only when
# you deploy the Cloudflare Worker with your own Supabase project.
TRACKER_BASE_URL=https://your-tracker.example.workers.dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only. The extension never receives it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-extension

# --- Optional Convex tracker (convex/) ---------------------------------------
# `npx convex dev --once` writes CONVEX_DEPLOYMENT and CONVEX_URL to .env.local.
# Set the token on the deployment, not here:
#   npx convex env set PERSONAL_API_TOKEN '<long random token>'
