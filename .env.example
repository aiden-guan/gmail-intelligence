# Tracker worker (Cloudflare)
TRACKER_BASE_URL=https://your-tracker.example.workers.dev
PERSONAL_API_TOKEN=generate-a-long-random-token
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-extension

# Optional: local wrangler
# wrangler secret put PERSONAL_API_TOKEN
# wrangler secret put SUPABASE_URL
# wrangler secret put SUPABASE_SERVICE_ROLE_KEY

# Extension (set via Settings UI; do not commit real keys)
# VITE_DEFAULT_TRACKER_URL is only a non-secret default host hint for local dev
VITE_DEFAULT_TRACKER_URL=http://127.0.0.1:8787

# AI keys are entered in the extension Settings page and stored in
# chrome.storage.local (service worker only). Never put them here for production.
